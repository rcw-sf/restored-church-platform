    // Validate the shape of a pending member document on create
    function isValidPendingMemberDoc(tenantId) {
      let d = request.resource.data;
      let allowedKeys = [
        'firstName', 'lastName', 'email', 'phone', 'gender', 'birthdate', 
        'baptizedDate', 'type', 'pledge', 'region', 'superRegion', 'ministry', 
        'membershipStartDate', 'requestType', 'status', 'createdAt', 'updatedAt', 
        'createdBy', 'targetMemberId', 'tenantId',
        'pushpayIndividualId', 'pushpayCommunityMemberKey', 'pushpaySpouseCommunityMemberKey'
      ];
      let requiredKeys = ['firstName', 'lastName', 'status', 'requestType', 'createdAt', 'createdBy'];
      
      return d.keys().hasOnly(allowedKeys) &&
             d.keys().hasAll(requiredKeys) &&
             d.firstName is string && d.firstName.size() > 0 && d.firstName.size() <= 50 &&
             d.lastName is string && d.lastName.size() > 0 && d.lastName.size() <= 50 &&
             d.status == 'pending' &&
             d.requestType in ['create', 'update', 'remove'] &&
             d.createdAt is string && d.createdAt.size() > 0 && d.createdAt.size() <= 30 &&
             d.createdBy is string && d.createdBy.lower() == request.auth.token.email.lower() &&
             
             // Optional field validations (if they exist)
             (!('tenantId' in d) || (d.tenantId == tenantId)) &&
             (!('gender' in d) || (d.gender is string && d.gender.size() <= 10)) &&
             (!('region' in d) || (d.region is string && d.region.size() <= 50)) &&
             (!('superRegion' in d) || (d.superRegion is string && d.superRegion.size() <= 50)) &&
             (!('ministry' in d) || (d.ministry is string && d.ministry.size() <= 50)) &&
             (!('pledge' in d) || (d.pledge is number)) &&
             (!('phone' in d) || (d.phone is string && d.phone.size() <= 25)) &&
             (!('email' in d) || (d.email is string && d.email.size() <= 254)) &&
             (!('birthdate' in d) || (d.birthdate is string && d.birthdate.size() <= 15)) &&
             (!('baptizedDate' in d) || (d.baptizedDate is string && d.baptizedDate.size() <= 15)) &&
             (!('type' in d) || (d.type is string && d.type.size() <= 50)) &&
             (!('membershipStartDate' in d) || (d.membershipStartDate is string && d.membershipStartDate.size() <= 15)) &&
             (!('membershipStopDate' in d) || (d.membershipStopDate is string && d.membershipStopDate.size() <= 15)) &&
             (!('updatedAt' in d) || (d.updatedAt is string && d.updatedAt.size() <= 30)) &&
             (!('targetMemberId' in d) || (d.targetMemberId is string && d.targetMemberId.size() <= 128)) &&
             (!('pushpayIndividualId' in d) || (d.pushpayIndividualId is string && d.pushpayIndividualId.size() <= 128)) &&
             (!('pushpayCommunityMemberKey' in d) || (d.pushpayCommunityMemberKey is string && d.pushpayCommunityMemberKey.size() <= 128)) &&
             (!('pushpaySpouseCommunityMemberKey' in d) || (d.pushpaySpouseCommunityMemberKey is string && d.pushpaySpouseCommunityMemberKey.size() <= 128));
    }

    // Checks if an editor is authorized to update their own pending request
    function canEditorUpdatePendingDoc(tenantId) {
      return canReadMembers(tenantId) &&
             resource.data.createdBy.lower() == request.auth.token.email.lower() &&
             resource.data.status == 'pending' &&
             request.resource.data.status == 'pending' &&
             request.resource.data.createdBy.lower() == resource.data.createdBy.lower() &&
             request.resource.data.createdAt == resource.data.createdAt &&
             request.resource.data.requestType == resource.data.requestType &&
             (!('targetMemberId' in resource.data) || request.resource.data.targetMemberId == resource.data.targetMemberId) &&
             isValidPendingMemberDoc(tenantId);
    }

    // ---------------------------------------------------------------
    // tenants/{tenantId}/members — church member PII
    // ---------------------------------------------------------------
    // superAdmin, admin, editor → read
    // superAdmin, admin         → write
    // ---------------------------------------------------------------
    match /tenants/{tenantId}/members/{memberId} {
      allow read: if canReadMembers(tenantId);
      allow write: if canWriteMembers(tenantId);
    }

    // tenants/{tenantId}/pending_members — member addition/edit requests
    match /tenants/{tenantId}/pending_members/{memberId} {
      allow read: if canReadMembers(tenantId);
      allow create: if canReadMembers(tenantId) && isValidPendingMemberDoc(tenantId);
      allow update: if canWriteMembers(tenantId) || canEditorUpdatePendingDoc(tenantId);
      allow delete: if canWriteMembers(tenantId);
    }

    // tenants/{tenantId}/additions — history of member additions
    match /tenants/{tenantId}/additions/{additionId} {
      allow read: if canReadMembers(tenantId);
      allow write: if canWriteMembers(tenantId);
    }
